layout {
  gaps 8 // Gap between windows
  center-focused-column "never" // Don’t auto-center focused column

  background-color "transparent" // <- needed for noctalia-shell to set wallpaper

  preset-column-widths {
    proportion 0.33333
    proportion 0.5
    proportion 0.66667
  }

  focus-ring {
    width 2
    active-color   "#62bac6"
    inactive-color "#21252b"
    urgent-color   "#e27881"
  }

  border {
    active-color   "#62bac6"
    inactive-color "#21252b"
    urgent-color   "#e27881"
  }

  shadow {
    color "#1d1f2370"
  }

  tab-indicator {
    active-color   "#62bac6"
    inactive-color "#16565f"
    urgent-color   "#e27881"
  }

  insert-hint {
    color "#62bac680"
  }
  
  struts {}
}

recent-windows {
  highlight {
    active-color "#62bac6"
    urgent-color "#e27881"
  }
}

